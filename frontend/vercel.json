{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://REPLACE-BACKEND.onrender.com/health"
    },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
